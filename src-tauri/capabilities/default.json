{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ChronoSpace Reader 默认权限集合",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "os:default"
  ]
}
