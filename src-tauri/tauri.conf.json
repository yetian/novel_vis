{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "时空编年史",
  "version": "0.1.24",
  "identifier": "app.chronospace.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "时空编年史 · ChronoSpace Reader",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "本地小说时空/人物/因果抽取与可视化",
    "longDescription": "ChronoSpace Reader 将 EPUB/MOBI/AZW3 小说解析入内存，借助本地大模型抽取时空、人物与因果结构，并以交互式时空图谱呈现。"
  }
}
